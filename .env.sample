# ctldap sample environment configuration
# Copy this file to ".env" and adjust the values. Every option not set here falls back to
# the default from ctldap.yml (shown below as the commented value).
# NOTE: For optional settings, the keyword "none" means "not set" - do NOT use an empty
# value, since yaml-env-defaults would then serve the literal placeholder instead.

# ============================== ChurchTools connection ==============================

# The URI pointing to the root of your ChurchTools installation (REQUIRED)
CT_URI=https://mysite.church.tools

# API token used to authenticate against ChurchTools (REQUIRED).
# The backing user needs sufficient churchdb permissions, typically:
#   view | view alldata(-1) | view grouptype(-1) | security level person(1,2*)
#   | security level group(*)
#   * = must also cover the security level of the group sync fields, see below.
# Obtain the token via https://<your-instance>/api > "Person" > "/persons/{personId}/logintoken"
API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ================================== LDAP server =====================================

# IP to listen on (0.0.0.0 = all interfaces)
#LDAP_IP=0.0.0.0

# LDAP server port (privileged default LDAP port would be 389)
#LDAP_PORT=1389

# LDAP base DN, served as "o=<value>", e.g. "o=churchtools"
#LDAP_BASE_DN=churchtools

# LDAP admin user: a "virtual" root user (recommended) or a ChurchTools username
#LDAP_USER=root

# Static password for the virtual LDAP admin user (NOT needed if LDAP_USER is a CT account).
# Use a LONG SECURE RANDOM password, ideally hashed with argon2 or bcrypt!
LDAP_PW=some-bcrypt-hash-or-argon2-hash-or-plaintext-password

# Serve lowercase DNs, required by some clients (e.g. ownCloud/Nextcloud)
#IS_DN_LOWER_CASE=true

# Serve lowercase email addresses, required by some clients (e.g. Seafile)
#IS_EMAIL_LOWER_CASE=true

# ==================================== Caching =======================================

# How old (in milliseconds) the user/group data may get before it is fetched from
# ChurchTools again. 0 (or "off"/"none"/"false"/"disabled") disables the cache, so every
# LDAP search fetches fresh data - useful for clients that cache LDAP data themselves,
# e.g. Synology DSM.
#CACHE_LIFETIME_MS=300000

# ==================================== Logging =======================================

# Add debug infos to the log (any non-empty string except "false" means "true")
#DEBUG=false

# Add verbose trace infos to the log (implies DEBUG)
#TRACE=false

# ================================== Email login =====================================

# Allow logins with ChurchTools email addresses: all emails of a person are served as
# ADDITIONAL uid values, so clients resolving logins via (uid=...) - notably SMB/samba -
# can authenticate users by email as well. The first uid value (the canonical account
# name, e.g. on Synology DSM) remains the ChurchTools username. Emails shared by
# multiple persons are dropped from all of them.
#EMAIL_LOGIN=false

# ============================ SMB support (e.g. Synology) ===========================

# ChurchTools cannot provide the NT hash needed for SMB/NTLM authentication. When
# enabled, ctldap computes it on each successful LDAP bind with a password, persists it
# (see SMB_STORE_FILE) and serves samba attributes (sambaNTPassword etc.).
# NOTE: Every user must log in once (e.g. at the DSM web GUI) before SMB access works,
# and once again after every ChurchTools password change.
#SMB_ENABLED=false

# Must match the SMB workgroup name of the file server (Synology DSM default: WORKGROUP)
#SMB_DOMAIN_NAME=WORKGROUP

# Storage file for NT hashes and the generated domain SID. NT hashes are
# password-equivalent secrets - keep this file/volume private!
# (In Docker, mount a volume at /app/data to survive restarts.)
#SMB_STORE_FILE=./data/smb-store.json

# Optional: fixed samba domain SID base ("S-1-5-21-x-y-z").
# Auto-generated and persisted if "none".
#SMB_SID_BASE=none

# ==================== Group sync (custom checkbox group fields) =====================
# Which ChurchTools groups become LDAP groups - and which members they carry - is
# controlled by custom checkbox group fields ("DB-Felder" in the ChurchTools group
# settings). Each GROUP_FIELD_* option names the ID of one such field (list your group
# fields incl. their IDs via GET https://<your-instance>/api/fields, category "f_group";
# the IDs are resolved via the REST API on every sync).
#
# EVERY checked field yields an own LDAP group, so a group with all five fields checked
# becomes five LDAP groups. The MEMBERS variant keeps the ChurchTools group name; every
# other variant appends its suffix, separated by a space (e.g. "Jugend LeiterInnen").
# Brackets are invalid in LDAP names and are removed from names and suffixes.
#
# As soon as at least one field ID is configured, ONLY groups with a checked field
# become LDAP groups. Set all five IDs to "none" to disable the filter and sync all
# groups (with their direct members). Users are never filtered by these options.
#
# IMPORTANT: The API token user must be allowed to see the fields, i.e. its churchdb
# permission "security level group" must cover the fields' security level - otherwise
# ChurchTools omits the fields from the API responses and NO group syncs.

# LDAP group carrying the group's direct members (leaders included).
# Its suffix is optional and empty by default ("none" = no suffix, i.e. the LDAP group
# is named like the ChurchTools group):
#GROUP_FIELD_MEMBERS=166
#GROUP_FIELD_MEMBERS_SUFFIX=none

# LDAP group carrying the direct members PLUS the leaders of all subgroups
# (the entire subtree of the ChurchTools group hierarchy):
#GROUP_FIELD_MEMBERS_SUBGROUP_LEADERS=172
#GROUP_FIELD_MEMBERS_SUBGROUP_LEADERS_SUFFIX=inkl. LeiterInnen untergeordneter Gruppen

# LDAP group carrying the members of the entire subgroup subtree. Useful for clients
# without nested-group support, e.g. Synology DSM shared folder permissions. Subgroups
# contribute their members even if they don't sync themselves:
#GROUP_FIELD_MEMBERS_SUBGROUPS=169
#GROUP_FIELD_MEMBERS_SUBGROUPS_SUFFIX=inkl. untergeordnete Gruppen

# LDAP group carrying only the members with a leader role (per ChurchTools group type
# role, "isLeader"):
#GROUP_FIELD_LEADERS=163
#GROUP_FIELD_LEADERS_SUFFIX=LeiterInnen

# LDAP group carrying the leaders of the group and of all subgroups:
#GROUP_FIELD_LEADERS_SUBGROUP_LEADERS=175
#GROUP_FIELD_LEADERS_SUBGROUP_LEADERS_SUFFIX=LeiterInnen inkl. untergeordnete Gruppen
