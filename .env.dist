# Add debug infos to log, non-empty string != "false" means "true"!
DEBUG=false
TRACE=false
# This is required for clients using lowercase DNs, e.g. ownCloud/nextCloud
IS_DN_LOWER_CASE=true
# This is required for clients that need lowercase email addresses, e.g. Seafile
IS_EMAIL_LOWER_CASE=true

# LDAP admin user, can be a "virtual" root user or a ChurchTools username (virtual root is recommended!)
LDAP_USER=root
# The static password to be used for the virtual ldapUser, i.e. if that one is NOT a CT account.
# Ideally, choose a LONG SECURE RANDOM password from a password generator like KeePass and hash it with argon2!
LDAP_PW=some-bcrypt-hash-or-argon2-hash-or-plaintext-password
# LDAP base DN, "o=<xxx>", e.g. "o=churchtools"
LDAP_BASE_DN=churchtools

# LDAP server ip to listen on, change it to 0.0.0.0 when external access required
LDAP_IP=0.0.0.0
# LDAP server port, you may change this to the privileged default port 389.
LDAP_PORT=1389

# The URI pointing to the root of your ChurchTools installation
CT_URI=https://mysite.church.tools
# This access token is used to authenticate against ChurchTools for API access.
# The backing user must be granted sufficient rights for the wrapper to work properly! Typically, these are:
# churchdb:{ view | view alldata(-1) | view grouptype(-1) | security level person(1,2*) | security level group(1*) }
# * = additional security levels might be required, depending on your ChurchTools settings.
# IMPORTANT: It is strongly recommended to use a LONG SECURE RANDOM password from a generator like KeePass for this user!
# You can obtain the API token from the API:
# - Login via https://your.ct.domain/api > "General" > "login" (copy your "personId" from the shown output!)
# - Get your token via "Person" > "/persons/{personId}/logintoken"
API_TOKEN=">>>insert API token here<<<"

# This controls (in milliseconds) how old the user/group data can be until it is fetched from ChurchTools again
CACHE_LIFETIME_MS=300000

# Allow logins with the ChurchTools email addresses: all emails of a person (any domain)
# are served as ADDITIONAL values of the uid attribute, so clients that resolve logins via
# (uid=...) lookups - notably SMB/samba - can authenticate users by email as well.
# The first uid value (the canonical account name, e.g. on Synology DSM) remains the
# ChurchTools username. Emails shared by multiple persons are dropped from all of them.
EMAIL_LOGIN=false

# Optional: Comma-separated list of ChurchTools group tag IDs to restrict the group sync.
# If set, only groups carrying at least one of these tags are provided as LDAP groups
# (memberships in all other groups are not visible via LDAP). Leave empty to sync all groups.
# Users are not filtered by this option. The available tags (with their IDs) can be listed
# via GET https://<your-instance>/api/tags/group
GROUP_SYNC_TAG_IDS=
# Optional: Comma-separated list of ChurchTools group tag IDs for leaders-only groups.
# A group carrying one of these tags is provided as an ADDITIONAL LDAP group that contains
# only the members with a leader role (ChurchTools group type role with "isLeader").
# A group may carry a GROUP_SYNC_TAG_IDS tag (regular group), one of these tags (leaders-only
# group) or both (both LDAP groups are provided).
GROUP_SYNC_TAG_IDS_LEADERSONLY=
# Name suffix for leaders-only groups, appended to the ChurchTools group name separated
# by a space, e.g. "Worship" -> "Worship LeiterIn". Default: LeiterIn
# NOTE: brackets are invalid in LDAP names and are removed from group names and usernames,
# so a suffix like "(LeiterIn)" ends up as "LeiterIn" as well.
GROUP_SYNC_LEADERS_ONLY_SUFFIX=LeiterIn
# Optional: A single ChurchTools group tag ID enabling recursive member collection.
# A group carrying this tag provides not only its direct members, but the members of all its
# subgroups (the entire subtree of the ChurchTools group hierarchy) as LDAP group members.
# Useful for clients without nested-group support, e.g. Synology DSM shared folder permissions.
# Subgroups contribute their members even if they are excluded by GROUP_SYNC_TAG_IDS themselves.
RECURSIVE_MEMBERS_TAG_ID=

# SMB/samba support (e.g. for Synology DSM shared folder access via SMB):
# ChurchTools does not provide the NT hash needed for SMB/NTLM authentication. When enabled,
# ctldap computes it on each successful LDAP bind with a password, persists it in SMB_STORE_FILE
# and serves samba attributes (sambaNTPassword etc.) with the user/group entries.
# NOTE: Every user must log in once (e.g. at the DSM web GUI) before SMB access works,
# and once again after every ChurchTools password change.
SMB_ENABLED=false
# Must match the SMB workgroup name of the file server (Synology DSM default: WORKGROUP).
SMB_DOMAIN_NAME=WORKGROUP
# Storage file for NT hashes and the generated domain SID. NT hashes are password-equivalent,
# keep this file/volume private! (In Docker, mount a volume at /app/data to survive restarts.)
SMB_STORE_FILE=./data/smb-store.json
# Optional: fixed samba domain SID base ("S-1-5-21-x-y-z"). Auto-generated and persisted if empty.
SMB_SID_BASE=